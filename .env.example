# Variáveis para deploy na Vercel (Project Settings → Environment Variables)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
JWT_SECRET=defina-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=7d
CORS_ORIGINS=

# Web Push (lembretes personalizados na PWA) — gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@seu-dominio.com
VITE_VAPID_PUBLIC_KEY=

# Dispatcher protegido (/api/cron/reminder-push) — mesmo valor no Vault (evolyn_cron_secret)
CRON_SECRET=

# Janela retroativa do dispatcher (minutos) quando o worker atrasa
REMINDER_PUSH_LOOKBACK_MINUTES=15
