SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
PORT=3001
JWT_SECRET=defina-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=7d
# Opcional — origens adicionais separadas por vírgula.
CORS_ORIGINS=
# Opcional — sem essa chave, o cadastro só valida o formato do email (sem
# checar se existe de verdade). Chave grátis em https://www.abstractapi.com/api/email-verification-validation-api
ABSTRACT_EMAIL_API_KEY=

# Opcional — cria uma conta administrativa somente no seed de desenvolvimento.
# Informe as duas variáveis juntas; a senha deve ter pelo menos 12 caracteres.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
